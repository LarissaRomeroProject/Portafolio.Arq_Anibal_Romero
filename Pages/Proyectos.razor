@page "/proyectos"

<PageTitle>Proyectos</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="projects-page">

    <MudText Typo="Typo.h2" Class="projects-title">
        Proyectos Destacados
    </MudText>

    <MudText Typo="Typo.body1" Class="projects-subtitle">
        Una selección de proyectos arquitectónicos modernos y funcionales.
    </MudText>

    <MudGrid Class="mt-8">

        <!-- Proyecto 1 -->
        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="project-card">

                <img src="images/proyecto1.png" class="project-image" />

                <div class="project-content">
                    <MudText Typo="Typo.h5" Class="project-name">
                        Casa Moderna
                    </MudText>

                    <MudText Typo="Typo.body2" Class="project-description">
                        Diseño contemporáneo con espacios abiertos e iluminación natural.
                    </MudText>
                </div>

            </MudPaper>
        </MudItem>

        <!-- Proyecto 2 -->
        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="project-card">

                <img src="images/proyecto2.png" class="project-image" />

                <div class="project-content">
                    <MudText Typo="Typo.h5" Class="project-name">
                        Residencia Minimalista
                    </MudText>

                    <MudText Typo="Typo.body2" Class="project-description">
                        Arquitectura elegante enfocada en simplicidad y armonía.
                    </MudText>
                </div>

            </MudPaper>
        </MudItem>

        <!-- Proyecto 3 -->
        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="project-card">

                <img src="images/proyecto3.png" class="project-image" />

                <div class="project-content">
                    <MudText Typo="Typo.h5" Class="project-name">
                        Diseño Urbano
                    </MudText>

                    <MudText Typo="Typo.body2" Class="project-description">
                        Integración moderna entre funcionalidad y estética urbana.
                    </MudText>
                </div>

            </MudPaper>
        </MudItem>

        <!-- Proyecto 4 -->
        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="project-card">

                <img src="images/proyecto4.png" class="project-image" />

                <div class="project-content">
                    <MudText Typo="Typo.h5" Class="project-name">
                        Diseño Urbano
                    </MudText>

                    <MudText Typo="Typo.body2" Class="project-description">
                        Integración moderna entre funcionalidad y estética urbana.
                    </MudText>
                </div>

            </MudPaper>
        </MudItem>
        
        <!-- Proyecto 5 -->
        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="project-card">

                <img src="images/proyecto5.png" class="project-image" />

                <div class="project-content">
                    <MudText Typo="Typo.h5" Class="project-name">
                        Diseño Urbano
                    </MudText>

                    <MudText Typo="Typo.body2" Class="project-description">
                        Integración moderna entre funcionalidad y estética urbana.
                    </MudText>
                </div>

            </MudPaper>
        </MudItem>
    </MudGrid>

</MudContainer>