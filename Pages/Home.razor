@page "/"

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="hero-container">

    <MudGrid AlignItems="AlignItems.Center" Class="hero-section">

        <MudItem xs="12" md="6">

            <div class="hero-content">

                <MudText Typo="Typo.body2" Class="hero-eyebrow">
                    Arquitectura &amp; Diseño
                </MudText>

                <MudText Typo="Typo.h1" Class="hero-title">
                    Diseño Arquitectónico Moderno
                </MudText>

                <MudText Typo="Typo.body1" Class="hero-description">
                    Creamos espacios elegantes, funcionales y contemporáneos
                    que transforman la experiencia de vivir y trabajar.
                </MudText>

                <div class="hero-buttons">

                    <MudButton Href="proyectos" Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               DisableElevation="true">
                        Ver proyectos
                    </MudButton>

                    <MudButton Href="contacto" Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Class="hero-link-button">
                        Contactar &nbsp;→
                    </MudButton>

                </div>

            </div>

        </MudItem>

        <MudItem xs="12" md="6" Class="hero-image-col">

            <div class="hero-image-wrap">

                <img src="images/arquitectura.jpeg"
                     alt="Proyecto arquitectónico"
                     class="hero-image" />

                <span class="hero-image-caption">
                    Diseño residencial contemporáneo
                </span>

            </div>

        </MudItem>

    </MudGrid>

</MudContainer>