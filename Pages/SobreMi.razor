@page "/sobre-mi"

<PageTitle>Sobre mí</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="about-page">

    <MudGrid AlignItems="AlignItems.Center">

        <!-- Imagen -->
        <MudItem xs="12" md="5">

            <img src="images/arquitectura.jpeg"
                 class="about-image" />

        </MudItem>

        <!-- Texto -->
        <MudItem xs="12" md="7">

            <div class="about-content">

                <MudText Typo="Typo.body2" Class="about-eyebrow">
                    Quién soy
                </MudText>

                <MudText Typo="Typo.h2" Class="about-title">
                    Sobre mí
                </MudText>

                <MudText Typo="Typo.body1" Class="about-description">
                    Arquitecto apasionado por el diseño contemporáneo,
                    especializado en crear espacios funcionales, elegantes
                    y visualmente impactantes.
                </MudText>

                <MudText Typo="Typo.body1" Class="about-description">
                    Mi enfoque combina estética moderna, innovación y
                    atención al detalle para desarrollar proyectos únicos
                    adaptados a las necesidades de cada cliente.
                </MudText>

                <div class="stat-row">

                    <div class="stat-item">
                        <MudText Class="stat-number">10+</MudText>
                        <MudText Class="stat-label">Años de experiencia</MudText>
                    </div>

                    <a href="https://www.instagram.com/edifarq_pa/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="stat-item instagram-link">
                        <MudIcon Icon="@Icons.Custom.Brands.Instagram" Class="instagram-icon" />
                        <MudText Class="stat-label">@@edifarq_pa</MudText>
                    </a>

                </div>

            </div>

        </MudItem>

    </MudGrid>

</MudContainer>