@page "/sobre-mi"

<PageTitle>Sobre mí</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="about-page">

    <MudGrid AlignItems="AlignItems.Center">

        <!-- Imagen -->
        <MudItem xs="12" md="5">

            <img src="images/anibal.jpeg"
                 class="about-image" />

        </MudItem>

        <!-- Texto -->
        <MudItem xs="12" md="7">

            <div class="about-content">

                <MudText Typo="Typo.h2" Class="about-title">
                    Sobre mí
                </MudText>

                <MudText Typo="Typo.body1" Class="about-description">
                    Arquitecto apasionado por el diseño contemporáneo,
                    especializado en crear espacios funcionales, elegantes
                    y visualmente impactantes.
                </MudText>

                <MudText Typo="Typo.body1" Class="about-description">
                    Mi enfoque combina estética moderna, innovación y
                    atención al detalle para desarrollar proyectos únicos
                    adaptados a las necesidades de cada cliente.
                </MudText>

                <MudGrid Class="mt-8">

                    <MudItem xs="6" md="3">
                        <div class="stat-card">
                            <MudText Class="stat-number">25+</MudText>
                            <MudText Class="stat-label">Proyectos</MudText>
                        </div>
                    </MudItem>

                    <MudItem xs="6" md="3">
                        <div class="stat-card">
                            <MudText Class="stat-number">10+</MudText>
                            <MudText Class="stat-label">Años</MudText>
                        </div>
                    </MudItem>

                    <MudItem xs="6" md="3">
                        <div class="stat-card">
                            <MudText Class="stat-number">50+</MudText>
                            <MudText Class="stat-label">Clientes</MudText>
                        </div>
                    </MudItem>

                </MudGrid>

            </div>

        </MudItem>

    </MudGrid>

</MudContainer>