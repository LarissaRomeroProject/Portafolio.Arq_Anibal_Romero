@inherits LayoutComponentBase
@using MudBlazor
@using Portafolio.Arq_Anibal_Romero.Themes

<MudThemeProvider Theme="@ArquitectoTheme.LightTheme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="0">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Edge="Edge.Start"
                       Color="Color.Dark"
                       OnClick="DrawerToggle" />

        <MudText Color="Color.Dark" Typo="Typo.h6" Class="appbar-title">
            ARQ. ANIBAL ROMERO
        </MudText>

        <MudSpacer />

        <MudButton Href="contacto"
                   Variant="Variant.Text"
                   Color="Color.Primary"
                   Class="appbar-cta">
            Contáctame
        </MudButton>

    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Anchor="Anchor.Start"
               Width="300px"
               Elevation="0">

        <div class="drawer-flex">

            <MudNavMenu Class="drawer-nav">

                <MudNavLink Href="" Match="NavLinkMatch.All">
                    Inicio
                </MudNavLink>

                <MudNavLink Href="proyectos">
                    Proyectos
                </MudNavLink>

                <MudNavLink Href="sobre-mi">
                    Sobre mí
                </MudNavLink>

                <MudNavLink Href="servicios">
                    Servicios
                </MudNavLink>

                <MudNavLink Href="contacto">
                    Contacto
                </MudNavLink>

            </MudNavMenu>

            <div class="drawer-footer">
                <a href="https://www.instagram.com/edifarq_pa/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="drawer-footer-link">
                    <MudIcon Icon="@Icons.Custom.Brands.Instagram" />
                    <span>@@edifarq_pa</span>
                </a>
            </div>

        </div>

    </MudDrawer>

    <MudMainContent>
        @Body
    </MudMainContent>

</MudLayout>

@code
{
    private bool _drawerOpen = true;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}